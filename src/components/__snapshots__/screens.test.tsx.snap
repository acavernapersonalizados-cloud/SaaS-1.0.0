            />
            <path
              d="M12 8h.01"
            />
          </svg>
        </div>
        <div>
          <p
            class="font-bold text-amber-900 text-sm mb-1"
          >
            Sobre os calculos
          </p>
          <p
            class="text-amber-700 text-xs leading-relaxed"
          >
            O custo total soma materiais (papel, adesivo, cartao etc.), acabamentos (laminacao, encadernacao) e mao de obra (montagem + acabamento + embalagem). O custo e dividido pela quantidade final de kits/conjuntos para chegar ao valor unitario.
          </p>
        </div>
      </div>
    </div>
  </div>
</body>
`;

exports[`Papelaria > material do estoque: busca, escolha e aviso de saldo 2`] = `"<div><div class="space-y-8 pb-20"><header><div class="flex items-center gap-2 text-neutral-400 mb-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text w-4 h-4" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M10 9H8"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg><span class="text-xs font-bold uppercase tracking-widest">Calculadora</span></div><h1 class="text-3xl font-black text-neutral-900">Papelaria Personalizada</h1><p class="text-neutral-500 mt-1">Convites, cadernos, agendas, kits e trabalhos graficos.</p></header><div class="grid grid-cols-1 lg:grid-cols-3 gap-6"><div class="lg:col-span-2 space-y-5"><div class="bg-white p-6 rounded-2xl border border-neutral-200 shadow-sm space-y-4"><h2 class="text-xs font-bold text-neutral-500 uppercase tracking-wider flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers w-3.5 h-3.5" aria-hidden="true"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg> Detalhes do Trabalho</h2><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div class="md:col-span-2 space-y-1"><label class="text-xs font-bold text-neutral-600">Nome do Trabalho</label><input placeholder="Ex: Convite casamento 15x21cm" class="w-full px-4 py-3 bg-neutral-50 border border-neutral-200 rounded-xl focus:ring-2 focus:ring-neutral-900 outline-none text-sm" type="text" value=""></div><div class="space-y-1"><label class="text-xs font-bold text-neutral-600">Quantidade final (kits/conjuntos)</label><input min="1" class="w-full px-4 py-3 bg-neutral-50 border border-neutral-200 rounded-xl focus:ring-2 focus:ring-neutral-900 outline-none text-sm" type="number" value="1"></div></div><div class="space-y-2 border-t border-neutral-100 pt-4"><p class="text-xs font-bold text-neutral-700 uppercase tracking-wider">Materiais (papel, adesivo, cartao, acetato, wire-o)</p><div class="flex gap-2 bg-neutral-100 p-1 rounded-xl w-fit"><button type="button" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-white text-neutral-900 shadow-sm"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-package w-3.5 h-3.5" aria-hidden="true"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"></path><path d="M12 22V12"></path><polyline points="3.29 7 12 12 20.71 7"></polyline><path d="m7.5 4.27 9 5.15"></path></svg> Do estoque</button><button type="button" class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold transition-all text-neutral-500"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus w-3.5 h-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> Material avulso</button></div><div class="space-y-2"><div class="relative"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class=