                            cx="9"
                            cy="9"
                            r="2"
                          />
                        </svg>
                      </button>
                    </div>
                    <input
                      accept="image/png,image/jpg,image/jpeg,image/webp"
                      class="hidden"
                      type="file"
                    />
                  </div>
                </div>
                <div
                  class="space-y-1.5"
                >
                  <label
                    class="text-xs font-bold text-neutral-600 uppercase tracking-wider"
                  >
                    Descrição para o Catálogo (opcional)
                  </label>
                  <textarea
