exports[`Cestas > material do estoque: busca, escolha e aviso de saldo 2`] = `"<div><div class="space-y-8 pb-20"><header><div class="flex items-center gap-2 text-neutral-400 mb-1"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gift w-4 h-4" aria-hidden="true"><rect x="3" y="8" width="18" height="4" rx="1"></rect><path d="M12 8v13"></path><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"></path><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"></path></svg><span class="text-xs font-bold uppercase tracking-widest">Calculadora</span></div><h1 class="text-3xl font-black text-neutral-900">Cestas Personalizadas</h1><p class="text-neutral-500 mt-1">Cestas de café da manha, kits presente e montagens personalizadas.</p></header><div class="grid grid-cols-1 lg:grid-cols-3 gap-6"><div class="lg:col-span-2 space-y-5"><div class="bg-white p-6 rounded-2xl border border-neutral-200 shadow-sm space-y-4"><h2 class="text-xs font-bold text-neutral-500 uppercase tracking-wider flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers w-3.5 h-3.5" aria-hidden="true"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg> Detalhes da Cesta</h2><div class="space-y-1"><label class="text-xs font-bold text-neutral-600">Nome da Cesta</label><input placeholder="Ex: Cesta Cafe da Manha Premium" class="w-full px-4 py-3 bg-neutral-50 border border-neutral-200 rounded-xl focus:ri