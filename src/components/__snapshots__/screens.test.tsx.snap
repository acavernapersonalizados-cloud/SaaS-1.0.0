l-900" type="text" value="Fita"></div><div class="grid grid-cols-5 gap-2"><select class="col-span-3 px-3 py-2 bg-neutral-50 border border-neutral-200 rounded-xl text-xs outline-none"><option value="">Selecione o item do estoque...</option><option value="fita">TESTE Fita cetim — R$&nbsp;1,20/m (estoque: 2)</option></select><input min="0.01" step="0.01" placeholder="Qtd" class="px-3 py-2 bg-neutral-50 border border-neutral-200 rounded-xl text-xs outline-none" type="number" value="50"><button type="button" class="px-2 py-2 bg-neutral-900 text-white rounded-xl hover:bg-neutral-800 text-xs font-bold disabled:opacity-40">Adicionar</button></div><p class="text-[11px] font-bold text-amber-600">TESTE Fita cetim: R$&nbsp;1,20/m · estoque disponível 2 m — quantidade acima do estoque atual</p></div></div><div class="grid grid-cols-1 md:grid-cols-3 gap-4 border-t border-neutral-100 pt-4"><div class="space-y-1"><label class="text-xs font-bold text-neutral-600">Embalagem (celofane, caixa, palha) - R$</label><input min="0" step="0.01" class="w-full px-4 py-3 bg-neutral-50 border border-neutral-200 rounded-xl focus:ring-2 focus:ring-neutral-900 outline-none text-sm" placeholder="0,00" type="number" value=""></div><div class="space-y-1"><label class="text-xs font-bold text-neutral-600">Fitas e Lacos - R$</label><input min="0" step="0.01" class="w-full px-4 py-3 bg-neutral-50 border border-neutral-200 rounded-xl focus:ring-2 focus:ring-neutral-900 outline-none text-sm" placeholder="0,00" type="number" value=""></div><div class="space-y-1"><label class="text-xs font-bold text-neutral-600">Etiqueta/Tag - R$</label><input min="0" step="0.01" class="w-full px-4 py-3 bg-neutral-50 border border-neutral-200 rounded-xl focus:ring-2 focus:ring-neutral-900 outline-none text-sm" placeholder="0,00" type="number" value=""></div></div><div class="grid grid-cols-1 md:grid-cols-2 gap-4"><div class="space-y-1"><label class="text-xs font-bold text-neutral-600">Tempo de Montagem (min)</label><input min="0" class="w-full px-4 py-3 bg-neutral-50 border border-neutral-200 rounded-xl focus:ring-2 focus:ring-neutral-900 outline-none text-sm" type="number" value=""></div><div class="space-y-1"><label class="text-xs font-bold text-neutral-600">Valor Hora Trabalho (R$)</label><input min="0" step="0.5" class="w-full px-4 py-3 bg-neutral-50 border border-neutral-200 rounded-xl focus:ring-2 focus:ring-neutral-900 outline-none text-sm" type="number" value="20"></div></div><div class="grid grid-cols-1 md:grid-cols-3 gap-4"><div class="space-y-1"><label class="text-xs font-bold text-neutral-600">Frete/Entrega (R$)</label><input min="0" step="0.01" class="w-full px-4 py-3 bg-neutral-50 border border-neutral-200 rounded-xl focus:ring-2 focus:ring-neutral-900 outline-none text-sm" placeholder="0,00" type="number" value=""></div><div class="space-y-1"><label class="text-xs font-bold text-neutral-600">Comissao Vendedor (%)</label><input min="0" max="99" class="w-full px-4 py-3 bg-neutral-50 border border-neutral-200 rounded-xl focus:ring-2 focus:ring-neutral-900 outline-none text-sm" placeholder="0" type="number" value=""></div><div class="space-y-1"><label class="text-xs font-bold text-neutral-600">Markup (% sobre o custo)</label><input min="0" max="500" class="w-full px-4 py-3 bg-neutral-50 border border-neutral-200 rounded-xl focus:ring-2 focus:ring-neutral-900 outline-none text-sm" type="number" value="100"></div><div class="space-y-1"><label class="text-xs font-bold text-neutral-600">Canal de venda</label><select class="w-full px-4 py-3 bg-neutral-50 border border-neutral-200 rounded-xl focus:ring-2 focus:ring-neutral-900 outline-none text-sm"><option value="venda-direta">Venda Direta</option><option value="instagram">Instagram</option><option value="atacado">Atacado</option><option value="shopee">Shopee</option><option value="mercado-livre">Mercado Livre</option><option value="ifood">iFood</option><option value="99food">99Food</option></select></div></div><div class="space-y-1"><label class="text-xs font-bold text-neutral-600">Quantidade de Cestas</label><input min="1" class="w-full px-4 py-3 bg-neutral-50 border border-neutral-200 rounded-xl focus:ring-2 focus:ring-neutral-900 outline-none text-sm" type="number" value="1"></div><textarea rows="2" class="w-full px-4 py-3 bg-neutral-50 border border-neutral-200 rounded-xl focus:ring-2 focus:ring-neutral-900 outline-none text-sm resize-none" placeholder="Observacoes (opcional)"></textarea></div></div><div class="space-y-4"><div class="bg-white p-5 rounded-2xl border border-neutral-200 shadow-sm space-y-4 sticky top-4"><h2 class="text-xs font-bold text-neutral-500 uppercase tracking-wider flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calculator w-3.5 h-3.5" aria-hidden="true"><rect width="16" height="20" x="4" y="2" rx="2"></rect><line x1="8" x2="16" y1="6" y2="6"></line><line x1="16" x2="16" y1="14" y2="18"></line><path d="M16 10h.01"></path><path d="M12 10h.01"></path><path d="M8 10h.01"></path><path d="M12 14h.01"></path><path d="M8 14h.01"></path><path d="M12 18h.01"></path><path d="M8 18h.01"></path></svg> Resultado</h2><div class="py-12 text-center text-neutral-400 text-sm italic">Adicione produtos ou tempo de montagem para calcular.</div></div></div></div><div class="bg-white p-6 rounded-2xl border border-neutral-200 shadow-sm space-y-4"><h2 class="text-base font-bold text-neutral-900">Cestas Salvas</h2><div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="border-b border-neutral-100"><th class="text-left py-2 pr-4 text-[10px] font-black text-neutral-400 uppercase tracking-wider">Cesta</th><th class="text-left py-2 pr-4 text-[10px] font-black text-neutral-400 uppercase tracking-wider">Qtd</th><th class="text-left py-2 pr-4 text-[10px] font-black text-neutral-400 uppercase tracking-wider">Preco</th><th class="text-left py-2 pr-4 text-[10px] font-black text-neutral-400 uppercase tracking-wider"></th></tr></thead><tbody><tr class="border-b border-neutral-50 hover:bg-neutral-50 transition-colors"><td class="py-3 pr-4 font-bold text-neutral-900">TESTE Café da manhã</td><td class="py-3 pr-4 text-right text-neutral-600">1</td><td class="py-3 pr-4 font-bold text-neutral-900 text-right">R$&nbsp;240,00</td><td class="py-3 text-right"><button class="p-1.5 text-neutral-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-all"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2 lucide-trash-2 w-3.5 h-3.5" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></td></tr></tbody></table></div></div><div class="bg-amber-50 p-5 rounded-2xl border border-amber-100 flex gap-4"><div class="w-9 h-9 bg-amber-100 rounded-full flex items-center justify-center flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info w-4 h-4 text-amber-600" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></div><div><p class="font-bold text-amber-900 text-sm mb-1">Sobre os calculos</p><p class="text-amber-700 text-xs leading-relaxed">O custo total soma produtos internos, embalagem (celofane, fitas, tags), mao de obra de montagem e frete. Se houver comissao de vendedor, o preco sugerido e ajustado para que a comissao nao reduza sua margem-alvo, seguindo a mesma logica de taxa de canal usada no restante do sistema.</p></div></div></div></div>"`;

exports[`Cestas > resultado e preço manual 1`] = `
<body>
