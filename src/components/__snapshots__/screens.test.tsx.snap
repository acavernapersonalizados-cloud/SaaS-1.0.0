                    </label>
                    <input
                      class="w-full px-4 py-3 bg-neutral-50 border border-neutral-200 rounded-xl focus:ring-2 focus:ring-neutral-900 outline-none text-sm"
                      min="0"
                      placeholder="Ex: 7"
                      type="number"
                      value="7"
                    />
                  </div>
                  <div
                    class="space-y-3"
                  >
                    <label
                      class="flex items-center gap-2 cursor-pointer mt-5"
                    >
                      <input
                        checked=""
                        class="w-4 h-4 rounded"
                        type="checkbox"
                      />
                      <span
                        class="text-xs font-bold text-neutral-600"
                      >
                        Exibir no catálogo
                      </span>
                    </label>
                    <label
                      class="flex items-center gap-2 cursor-pointer"
                    >
                      <input
                        checked=""
                        class="w-4 h-4 rounded"
                        type="checkbox"
                      />
                      <span
                        class="text-xs font-bold text-neutral-600"
                      >
                        Exibir preço
                      </span>
                    </label>
                  </div>
                </div>
              </div>
              <div
                class="sticky -bottom-6 -mx-8 -mb-6 px-8 pb-6 pt-4 bg-white border-t border-neutral-100"
              >
                <button
                  class="w-full py-4 bg-neutral-900 text-white rounded-2xl font-bold hover:bg-neutral-800 transition-all shadow-lg"
                  type="submit"
                >
                  Atualizar Produto
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
`;

