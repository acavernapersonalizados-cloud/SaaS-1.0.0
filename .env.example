# ─────────────────────────────────────────────────────────────────────────────
# PrecificaAteliê — Variáveis de Ambiente
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copie este arquivo para .env
# 2. Preencha com as credenciais do seu projeto Firebase
#    Firebase Console → Configurações do Projeto → Seus apps → Config do SDK
# 3. Reinicie o servidor de desenvolvimento após alterar

# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=        # opcional

# IA (Firebase AI Logic + App Check)
# A chave do Gemini NÃO vai aqui: fica só no Firebase (console → Serviços de IA → AI Logic).
# Chave do site do reCAPTCHA Enterprise usada pelo App Check (Google Cloud → reCAPTCHA → chave Web,
# domínios saas-1-0-0.web.app e saas-1-0-0.firebaseapp.com). É pública: o navegador precisa dela.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
