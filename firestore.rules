rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // IMPORTANTE (correção de segurança):
    // As regras antigas usavam `allow list: if isAuthenticated();`, o que
    // permitia que QUALQUER usuário logado (inclusive pendente de aprovação)
    // lesse os dados de TODAS as lojas simplesmente consultando a coleção sem
    // filtro. Agora `read` (get + list) é sempre validado por loja, o que
    // obriga o cliente a filtrar por storeId — exatamente como o app já faz.
    // ─────────────────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }
    function getUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function userData() {
      return get(getUserPath()).data;
    }
    function isAdmin() {
      let adminEmail = "ricoslim@gmail.com";
      return isAuthenticated() && (
        request.auth.token.email == adminEmail ||
        (exists(getUserPath()) && userData().get('role', '') == 'ADMIN')
      );
    }
    function isGerente() {
      return isAuthenticated() &&
             exists(getUserPath()) &&
             userData().get('role', '') == 'GERENTE';
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function hasStoreAccess(storeId) {
      return isAuthenticated() && storeId != null && (
        isAdmin() || (
          exists(getUserPath()) &&
          // tolerante: só bloqueia quem está explicitamente pendente/bloqueado
          !(userData().get('status', 'aprovado') in ['pendente', 'bloqueado']) &&
          userData().get('storeIds', []).hasAny([storeId])
        )
      );
    }
    // Leitura/escrita padrão de documento de loja
    function canRead(storeId)  { return hasStoreAccess(storeId); }
    function canWrite(storeId) { return hasStoreAccess(storeId); }
    function canDelete(storeId) { return isAdmin() || (hasStoreAccess(storeId) && isGerente()); }

    // ── Lojas ────────────────────────────────────────────────────────────────
    match /stores/{storeId} {
      // get público: necessário para o catálogo público (/catalogo/:storeId)
      allow get: if true;
      // A consulta usa uma lista de IDs; o Firestore não consegue validar
      // hasStoreAccess(storeId) nessa operação. Apenas usuários logados listam lojas.
      allow list: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin() || (hasStoreAccess(storeId) && isGerente());
      allow delete: if isAdmin();
    }

    // ── Usuários ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() ||
                  (isGerente() && userData().get('storeIds', []).hasAny(resource.data.get('storeIds', [])));
      // Autocadastro: sempre OPERADOR, pendente e SEM lojas (quem aprova define as lojas)
      allow create: if isAdmin() ||
                    (isGerente() && request.resource.data.get('role', '') != 'ADMIN') ||
                    (isOwner(userId) &&
                     request.resource.data.get('role', '') == 'OPERADOR' &&
                     request.resource.data.get('status', '') == 'pendente' &&
                     request.resource.data.get('storeIds', []).size() == 0);
      allow update: if isAdmin() ||
                    (isGerente() && resource.data.get('role', '') != 'ADMIN' && request.resource.data.get('role', '') != 'ADMIN') ||
                    (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone']));
      allow delete: if isAdmin() || (isGerente() && resource.data.get('role', '') != 'ADMIN');
    }

    // ── Base de custos (1 doc por loja) ──────────────────────────────────────
    match /costBases/{storeId} {
      allow read: if canRead(storeId);
      allow write: if isAdmin() || (hasStoreAccess(storeId) && isGerente());
    }

    // ── Produtos ─────────────────────────────────────────────────────────────
    match /products/{productId} {
      // Catálogo público: apenas produtos marcados para o catálogo
      allow read: if resource.data.get('showInCatalog', true) == true
                  || canRead(resource.data.storeId);
      allow create: if canWrite(request.resource.data.storeId);
      // Etapa 7.1: nenhuma versão do app (nem uma antiga ainda aberta) pode trocar um preço de
      // catálogo maior que zero por R$ 0. Ocultar do catálogo (showInCatalog/showPrice) continua livre.
      allow update: if canWrite(request.resource.data.storeId)
                    && !(resource.data.get('catalogPrice', 0) > 0
                         && request.resource.data.get('catalogPrice', 0) <= 0);
      allow delete: if canDelete(resource.data.storeId);
    }

    // ── Categorias (matéria-prima/estoque e produtos) ───────────────────────
    // Leitura pública apenas para categorias de produto, usadas como filtro no
    // catálogo público. Categorias de matéria-prima ficam restritas à loja.
    match /categories/{categoryId} {
      allow read: if resource.data.get('scope', '') == 'product'
                  || canRead(resource.data.storeId);
      allow create, update: if canWrite(request.resource.data.storeId);
      allow delete: if canDelete(resource.data.storeId);
    }

    // ── Demais coleções por loja ─────────────────────────────────────────────
    match /materials/{materialId} {
      allow read: if canRead(resource.data.storeId);
      allow create, update: if canWrite(request.resource.data.storeId);
      allow delete: if canDelete(resource.data.storeId);
    }

    match /quotes/{quoteId} {
      allow read: if canRead(resource.data.storeId);
      allow create: if canWrite(request.resource.data.storeId);
      // Finalizar é permitido somente ao autor do orçamento, ADMIN ou GERENTE.
      // Orçamentos antigos sem createdBy continuam administráveis pelos gestores.
      allow update: if canWrite(request.resource.data.storeId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
        request.resource.data.status != 'Finalizado' ||
        isAdmin() ||
        isGerente() ||
        resource.data.get('createdBy', '') == request.auth.uid
      );
      allow delete: if canDelete(resource.data.storeId);
    }

    match /clients/{clientId} {
      allow read: if canRead(resource.data.storeId);
      allow create, update: if canWrite(request.resource.data.storeId);
      allow delete: if canDelete(resource.data.storeId);
    }

    match /suppliers/{supplierId} {
      allow read: if canRead(resource.data.storeId);
      allow create, update: if canWrite(request.resource.data.storeId);
      allow delete: if canDelete(resource.data.storeId);
    }

    match /laserJobs/{jobId} {
      allow read: if canRead(resource.data.storeId);
      allow create, update: if canWrite(request.resource.data.storeId);
      allow delete: if canDelete(resource.data.storeId);
    }

    match /laserMachines/{machineId} {
      allow read: if canRead(resource.data.storeId);
      allow create, update: if canWrite(request.resource.data.storeId);
      allow delete: if canDelete(resource.data.storeId);
    }

    match /printers/{printerId} {
      allow read: if canRead(resource.data.storeId);
      allow create, update: if canWrite(request.resource.data.storeId);
      allow delete: if canDelete(resource.data.storeId);
    }

    match /printJobs/{jobId} {
      allow read: if canRead(resource.data.storeId);
      allow create, update: if canWrite(request.resource.data.storeId);
      allow delete: if canDelete(resource.data.storeId);
    }

    match /papelariaJobs/{jobId} {
      allow read: if canRead(resource.data.storeId);
      allow create, update: if canWrite(request.resource.data.storeId);
      allow delete: if hasStoreAccess(resource.data.storeId);
    }

    match /cestaJobs/{jobId} {
      allow read: if canRead(resource.data.storeId);
      allow create, update: if canWrite(request.resource.data.storeId);
      allow delete: if hasStoreAccess(resource.data.storeId);
    }

    match /purchaseList/{itemId} {
      allow read: if canRead(resource.data.storeId);
      allow create, update: if canWrite(request.resource.data.storeId);
      allow delete: if hasStoreAccess(resource.data.storeId);
    }

    // ── Estoque: agora restrito à loja do documento ──────────────────────────
    match /stockMovements/{movId} {
      allow read: if canRead(resource.data.storeId);
      allow create: if canWrite(request.resource.data.storeId);
      allow update, delete: if isAdmin();
    }

    match /stockReservations/{resId} {
      allow read: if canRead(resource.data.storeId);
      allow create: if canWrite(request.resource.data.storeId);
      allow update: if canWrite(resource.data.storeId);
      allow delete: if isAdmin();
    }

    // Nega tudo o que não foi declarado acima
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
